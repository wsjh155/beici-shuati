.page {
    box-sizing: border-box;
    min-height: 100vh;
    padding: 24rpx 32rpx 48rpx;
}

.content {
    display: flex;
    flex-direction: column;
}

.list-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin: 12rpx 8rpx 20rpx;
}

.list-title {
    font-size: 30rpx;
    font-weight: 600;
    color: #1f2329;
}

.list-count {
    font-size: 24rpx;
    color: #8a94a6;
}

.empty {
    display: flex;
    align-items: center;
    flex-direction: column;
    padding: 96rpx 0;
}

.empty-emoji {
    font-size: 72rpx;
}

.empty-text {
    margin-top: 24rpx;
    font-size: 30rpx;
    color: #1f2329;
}

.empty-sub {
    margin-top: 12rpx;
    font-size: 24rpx;
    color: #8a94a6;
}

.wrong-item {
    padding: 28rpx;
    margin-bottom: 20rpx;
    border-radius: 24rpx;
    background: #ffffff;
    box-shadow: 0 4rpx 16rpx rgba(31, 35, 41, 0.04);
}

.wrong-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 16rpx;
}

.wrong-type {
    padding: 4rpx 16rpx;
    font-size: 22rpx;
    color: #e5484d;
    background: #fdecec;
    border-radius: 16rpx;
}

.tag-wrap {
    display: flex;
    align-items: center;
}

.ai-badge {
    margin-left: 12rpx;
    padding: 4rpx 16rpx;
    font-size: 22rpx;
    color: #b7791f;
    background: #fff3e0;
    border-radius: 16rpx;
}

.wrong-count {
    font-size: 22rpx;
    color: #8a94a6;
}

.wrong-stem {
    display: block;
    font-size: 30rpx;
    line-height: 1.6;
    color: #1f2329;
}

.wrong-answer {
    display: flex;
    align-items: center;
    margin-top: 16rpx;
    padding: 16rpx 20rpx;
    border-radius: 12rpx;
    background: #eafaf3;
}

.wrong-answer-label {
    font-size: 24rpx;
    color: #17a673;
}

.wrong-answer-value {
    margin-left: 16rpx;
    font-size: 28rpx;
    font-weight: 600;
    color: #17a673;
}

.wrong-analysis {
    display: block;
    margin-top: 16rpx;
    font-size: 26rpx;
    line-height: 1.6;
    color: #8a94a6;
}

.wrong-actions {
    display: flex;
    justify-content: flex-end;
    margin-top: 20rpx;
}

.remove-btn {
    color: #3b6ef5;
    background: #e8efff;
}
