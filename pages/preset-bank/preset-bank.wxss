.page {
    box-sizing: border-box;
    min-height: 100vh;
    padding: 24rpx 32rpx 48rpx;
}

.content {
    display: flex;
    flex-direction: column;
}

.header {
    padding: 16rpx 8rpx 24rpx;
}

.title {
    display: block;
    font-size: 40rpx;
    font-weight: 700;
    color: #1f2329;
}

.subtitle {
    display: block;
    margin-top: 8rpx;
    font-size: 26rpx;
    color: #8a94a6;
}

.empty {
    display: flex;
    align-items: center;
    flex-direction: column;
    padding: 96rpx 0;
}

.empty-emoji {
    font-size: 72rpx;
}

.empty-text {
    margin-top: 24rpx;
    font-size: 30rpx;
    color: #1f2329;
}

.group {
    margin-bottom: 8rpx;
}

.group-title {
    display: block;
    margin: 24rpx 8rpx 16rpx;
    font-size: 28rpx;
    font-weight: 600;
    color: #3b6ef5;
}

.bank-item {
    display: flex;
    align-items: center;
    padding: 24rpx;
    margin-bottom: 16rpx;
    border-radius: 20rpx;
    background: #ffffff;
    box-shadow: 0 4rpx 12rpx rgba(31, 35, 41, 0.04);
}

.bank-info {
    flex: 1;
    overflow: hidden;
}

.bank-name {
    display: block;
    font-size: 30rpx;
    font-weight: 600;
    color: #1f2329;
}

.bank-desc {
    display: block;
    margin-top: 6rpx;
    font-size: 24rpx;
    color: #8a94a6;
}

.bank-count {
    display: block;
    margin-top: 6rpx;
    font-size: 22rpx;
    color: #b6bcc8;
}

.btn-subscribe {
    flex-shrink: 0;
    margin-left: 20rpx;
    width: 140rpx;
    height: 68rpx;
    line-height: 68rpx;
    font-size: 26rpx;
    font-weight: 600;
    color: #ffffff;
    background: #3b6ef5;
    border-radius: 34rpx;
}

.btn-subscribed {
    flex-shrink: 0;
    margin-left: 20rpx;
    width: 140rpx;
    height: 68rpx;
    line-height: 68rpx;
    font-size: 26rpx;
    color: #8a94a6;
    background: #f0f1f2;
    border-radius: 34rpx;
}
