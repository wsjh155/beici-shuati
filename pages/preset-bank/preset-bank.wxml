<view class="page">
    <view wx:if="{{authState === 'checking'}}" class="state-box">
        <view class="spinner"></view>
        <text class="state-text">加载中...</text>
    </view>

    <view wx:elif="{{authState === 'signed-out'}}">
        <login-panel bind:signedin="onSignedIn" />
    </view>

    <view wx:else class="content">
        <view class="header">
            <text class="title">我的题库 / 词库</text>
            <text class="subtitle">管理自己已订阅的内容，可单独练习或取消订阅</text>
        </view>

        <view class="entry-row">
            <button class="entry-btn" bindtap="goSubscribe">去「预设题库」订阅更多</button>
        </view>

        <view class="tab-bar">
            <view class="tab-item {{tab === 'question' ? 'active' : ''}}" data-tab="question" bindtap="onTabTap">题库 {{totalQuestions}} 题</view>
            <view class="tab-item {{tab === 'word' ? 'active' : ''}}" data-tab="word" bindtap="onTabTap">词库 {{totalWords}} 词</view>
        </view>

        <view wx:if="{{tab === 'question'}}">
            <view wx:if="{{myBanks.length === 0 && !loading}}" class="empty">
                <text class="empty-emoji">📭</text>
                <text class="empty-text">还没有题库</text>
                <text class="empty-sub">到「预设题库」订阅，或「刷题 → 新建题库」自己建</text>
            </view>
            <view class="bank-item" wx:for="{{myBanks}}" wx:key="id">
                <view class="bank-info" data-id="{{item.id}}" bindtap="goPractice">
                    <text class="bank-name">{{item.name}}</text>
                    <text class="bank-desc" wx:if="{{item.description}}">{{item.description}}</text>
                    <text class="bank-count">{{item.count}} 题{{item.fromPreset ? ' · 订阅所得' : ''}}</text>
                </view>
                <button class="btn-remove" data-id="{{item.id}}" data-kind="question" data-name="{{item.name}}" loading="{{removingId === item.id}}" catchtap="onRemove">取消订阅</button>
            </view>
        </view>

        <view wx:if="{{tab === 'word'}}">
            <view wx:if="{{myBooks.length === 0 && !loading}}" class="empty">
                <text class="empty-emoji">📚</text>
                <text class="empty-text">还没有词库</text>
                <text class="empty-sub">到「预设题库」订阅词库</text>
            </view>
            <view class="bank-item" wx:for="{{myBooks}}" wx:key="id">
                <view class="bank-info" data-id="{{item.id}}" bindtap="goStudy">
                    <text class="bank-name">{{item.name}}</text>
                    <text class="bank-desc" wx:if="{{item.description}}">{{item.description}}</text>
                    <text class="bank-count">{{item.count}} 词{{item.fromPreset ? ' · 订阅所得' : ''}}</text>
                </view>
                <button class="btn-remove" data-id="{{item.id}}" data-kind="word" data-name="{{item.name}}" loading="{{removingId === item.id}}" catchtap="onRemove">取消订阅</button>
            </view>
        </view>
    </view>
</view>
