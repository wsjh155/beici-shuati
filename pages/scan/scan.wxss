.page {
    box-sizing: border-box;
    min-height: 100vh;
    padding: 24rpx 32rpx 48rpx;
}

.content {
    display: flex;
    flex-direction: column;
}

.field-label {
    display: block;
    margin: 24rpx 0 16rpx;
    font-size: 26rpx;
    color: #8a94a6;
}

.picker-value {
    height: 84rpx;
    line-height: 84rpx;
    padding: 0 24rpx;
    font-size: 28rpx;
    color: #1f2329;
    background: #f4f6fb;
    border-radius: 16rpx;
}

.input {
    height: 84rpx;
    padding: 0 24rpx;
    font-size: 28rpx;
    background: #f4f6fb;
    border-radius: 16rpx;
}

/* 图片区域 */
.photo-placeholder {
    display: flex;
    align-items: center;
    flex-direction: column;
    padding: 80rpx 32rpx;
    margin-top: 24rpx;
    border: 2rpx dashed #c0c6cf;
    border-radius: 24rpx;
    background: #ffffff;
}

.photo-icon {
    font-size: 80rpx;
}

.photo-text {
    margin-top: 24rpx;
    font-size: 30rpx;
    color: #1f2329;
}

.photo-sub {
    margin-top: 12rpx;
    font-size: 24rpx;
    color: #8a94a6;
    text-align: center;
}

.photo-area {
    margin-top: 24rpx;
}

.photo-preview {
    width: 100%;
    height: 420rpx;
    border-radius: 24rpx;
    background: #f0f1f2;
}

.photo-actions {
    display: flex;
    margin-top: 20rpx;
}

.btn-rechoose {
    flex: 1;
    margin-right: 20rpx;
    height: 84rpx;
    line-height: 84rpx;
    font-size: 28rpx;
    color: #3b6ef5;
    background: #e8efff;
    border-radius: 42rpx;
}

.btn-recognize {
    flex: 1;
    height: 84rpx;
    line-height: 84rpx;
    font-size: 28rpx;
    font-weight: 600;
    color: #ffffff;
    background: #3b6ef5;
    border-radius: 42rpx;
}

/* 表单 */
.form {
    margin-top: 32rpx;
    padding: 32rpx;
    border-radius: 24rpx;
    background: #ffffff;
    box-shadow: 0 4rpx 16rpx rgba(31, 35, 41, 0.04);
}

.form-title {
    display: block;
    font-size: 30rpx;
    font-weight: 700;
    color: #1f2329;
}

.type-row {
    display: flex;
}

.type-btn {
    flex: 1;
    height: 76rpx;
    line-height: 76rpx;
    font-size: 28rpx;
    color: #8a94a6;
    text-align: center;
    background: #f4f6fb;
    border-radius: 16rpx;
}

.type-btn + .type-btn {
    margin-left: 16rpx;
}

.type-active {
    color: #ffffff;
    background: #3b6ef5;
    font-weight: 600;
}

.textarea {
    box-sizing: border-box;
    width: 100%;
    min-height: 160rpx;
    padding: 24rpx;
    font-size: 28rpx;
    line-height: 1.6;
    background: #f4f6fb;
    border-radius: 16rpx;
}

.option-row {
    display: flex;
    align-items: center;
    margin-bottom: 16rpx;
}

.option-label {
    display: flex;
    width: 56rpx;
    height: 56rpx;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    border-radius: 50%;
    background: #eef1f6;
    color: #1f2329;
    font-size: 26rpx;
    font-weight: 600;
}

.option-input {
    flex: 1;
    margin-left: 20rpx;
}

.judge-row {
    display: flex;
}

.judge-btn {
    flex: 1;
    height: 76rpx;
    line-height: 76rpx;
    font-size: 28rpx;
    color: #8a94a6;
    text-align: center;
    background: #f4f6fb;
    border-radius: 16rpx;
}

.judge-btn + .judge-btn {
    margin-left: 20rpx;
}

.judge-right {
    color: #ffffff;
    background: #17a673;
    font-weight: 600;
}

.judge-wrong {
    color: #ffffff;
    background: #e5484d;
    font-weight: 600;
}

.btn-generate {
    margin-top: 32rpx;
    height: 88rpx;
    line-height: 88rpx;
    font-size: 28rpx;
    font-weight: 600;
    color: #3b6ef5;
    background: #e8efff;
    border-radius: 44rpx;
}

.manual-note {
    display: flex;
    flex-direction: column;
    padding: 22rpx 26rpx;
    margin-bottom: 24rpx;
    background: #eef3ff;
    border-radius: 16rpx;
}

.manual-note-title {
    font-size: 27rpx;
    font-weight: 600;
    color: #3b6ef5;
}

.manual-note-text {
    margin-top: 8rpx;
    font-size: 24rpx;
    line-height: 1.6;
    color: #5a6478;
}

.ai-tag {
    display: block;
    margin-top: 16rpx;
    font-size: 24rpx;
    color: #b7791f;
    text-align: center;
}

.btn-save {
    margin-top: 24rpx;
    height: 88rpx;
    line-height: 88rpx;
    font-size: 30rpx;
    font-weight: 600;
    color: #ffffff;
    background: #3b6ef5;
    border-radius: 44rpx;
}
