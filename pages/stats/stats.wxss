.page {
    box-sizing: border-box;
    min-height: 100vh;
    padding: 24rpx 32rpx 48rpx;
}

.content {
    display: flex;
    flex-direction: column;
}

.stat-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
}

.stat-card {
    box-sizing: border-box;
    width: 48.5%;
    margin-bottom: 24rpx;
    padding: 36rpx 32rpx;
    border-radius: 24rpx;
    background: #ffffff;
    box-shadow: 0 4rpx 16rpx rgba(31, 35, 41, 0.04);
}

.stat-primary {
    background: linear-gradient(135deg, #3b6ef5, #5b8cff);
}

.stat-green {
    background: linear-gradient(135deg, #17a673, #3ecb96);
}

.stat-primary .stat-num,
.stat-green .stat-num {
    color: #ffffff;
}

.stat-primary .stat-label,
.stat-green .stat-label {
    color: rgba(255, 255, 255, 0.9);
}

.stat-num {
    display: block;
    font-size: 56rpx;
    font-weight: 700;
    color: #1f2329;
}

.stat-label {
    display: block;
    margin-top: 8rpx;
    font-size: 26rpx;
    color: #8a94a6;
}

.detail-card {
    margin-top: 8rpx;
    padding: 8rpx 32rpx;
    border-radius: 24rpx;
    background: #ffffff;
    box-shadow: 0 4rpx 16rpx rgba(31, 35, 41, 0.04);
}

.detail-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 28rpx 0;
    border-bottom: 2rpx solid #f0f1f2;
}

.detail-row:last-child {
    border-bottom: none;
}

.detail-label {
    font-size: 28rpx;
    color: #1f2329;
}

.detail-value {
    font-size: 28rpx;
    color: #8a94a6;
}
