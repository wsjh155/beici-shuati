.page {
    box-sizing: border-box;
    min-height: 100vh;
    padding: 24rpx 32rpx 48rpx;
}

.content {
    display: flex;
    flex-direction: column;
}

.header {
    padding: 16rpx 8rpx 24rpx;
}

.title {
    display: block;
    font-size: 40rpx;
    font-weight: 700;
    color: #1f2329;
}

.subtitle {
    display: block;
    margin-top: 8rpx;
    font-size: 26rpx;
    color: #8a94a6;
}

.empty {
    display: flex;
    align-items: center;
    flex-direction: column;
    padding: 96rpx 0;
}

.empty-emoji {
    font-size: 72rpx;
}

.empty-text {
    margin-top: 24rpx;
    font-size: 30rpx;
    color: #1f2329;
}

.series {
    margin-bottom: 8rpx;
}

.series-title {
    display: block;
    margin: 24rpx 8rpx 16rpx;
    font-size: 28rpx;
    font-weight: 600;
    color: #3b6ef5;
}

.lib-row {
    display: flex;
    flex-direction: column;
}

.lib-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 24rpx;
    border-radius: 20rpx;
    background: #ffffff;
    box-shadow: 0 4rpx 12rpx rgba(31, 35, 41, 0.04);
}

.lib-item + .lib-item {
    margin-top: 16rpx;
}

.lib-order {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-left: 12rpx;
    height: 52rpx;
    padding: 0 18rpx;
    border-radius: 26rpx;
    background: #eef2fb;
}

.lib-order-text {
    font-size: 22rpx;
    font-weight: 600;
    line-height: 1;
    color: #3b6ef5;
}

.lib-subscribe {
    flex-shrink: 0;
    margin-left: 16rpx;
    height: 60rpx;
    line-height: 60rpx;
    padding: 0 32rpx;
    font-size: 26rpx;
    font-weight: 600;
    color: #ffffff;
    background: #3b6ef5;
    border-radius: 30rpx;
}

.lib-subscribe.subscribed {
    color: #8a94a6;
    background: #eef1f6;
}

.lib-info {
    flex: 1;
    overflow: hidden;
}

.lib-name {
    display: block;
    font-size: 28rpx;
    font-weight: 600;
    color: #1f2329;
}

.lib-count {
    display: block;
    margin-top: 6rpx;
    font-size: 22rpx;
    color: #b6bcc8;
}

.lib-arrow {
    font-size: 40rpx;
    color: #c0c6cf;
}
