.page {
    box-sizing: border-box;
    min-height: 100vh;
    padding: 32rpx 32rpx 48rpx;
}

.content {
    display: flex;
    flex-direction: column;
}

.hero {
    padding: 24rpx 8rpx;
}

.hero-title {
    display: block;
    font-size: 40rpx;
    font-weight: 700;
    color: #1f2329;
}

.hero-sub {
    display: block;
    margin-top: 8rpx;
    font-size: 26rpx;
    color: #8a94a6;
}

.overview {
    display: flex;
    margin-top: 24rpx;
}

.overview-card {
    flex: 1;
    box-sizing: border-box;
    padding: 32rpx;
    border-radius: 24rpx;
    background: linear-gradient(135deg, #3b6ef5, #5b8cff);
    color: #ffffff;
}

.overview-card + .overview-card {
    margin-left: 24rpx;
    background: linear-gradient(135deg, #17a673, #3ecb96);
}

.overview-num {
    display: block;
    font-size: 56rpx;
    font-weight: 700;
}

.overview-label {
    display: block;
    margin-top: 8rpx;
    font-size: 26rpx;
    opacity: 0.92;
}

.plan-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 24rpx;
    padding: 28rpx 32rpx;
    border-radius: 24rpx;
    background: #ffffff;
    box-shadow: 0 4rpx 16rpx rgba(31, 35, 41, 0.04);
}

.plan-title {
    display: block;
    font-size: 30rpx;
    font-weight: 700;
    color: #1f2329;
}

.plan-desc {
    display: block;
    margin-top: 8rpx;
    font-size: 24rpx;
    color: #8a94a6;
}

.plan-go {
    flex-shrink: 0;
    margin-left: 20rpx;
    padding: 12rpx 28rpx;
    font-size: 26rpx;
    font-weight: 600;
    color: #ffffff;
    background: #3b6ef5;
    border-radius: 30rpx;
}

.section-title {
    display: block;
    margin: 40rpx 8rpx 20rpx;
    font-size: 30rpx;
    font-weight: 600;
    color: #1f2329;
}

.menu-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
}

.menu-item {
    box-sizing: border-box;
    width: 48.5%;
    margin-bottom: 24rpx;
    padding: 28rpx;
    border-radius: 24rpx;
    background: #ffffff;
    box-shadow: 0 4rpx 16rpx rgba(31, 35, 41, 0.04);
}

.menu-emoji {
    display: block;
    font-size: 48rpx;
}

.menu-text {
    display: block;
    margin-top: 16rpx;
    font-size: 30rpx;
    font-weight: 600;
    color: #1f2329;
}

.menu-desc {
    display: block;
    margin-top: 6rpx;
    font-size: 24rpx;
    color: #8a94a6;
}

/* 游客态功能介绍：让用户在被引导登录前先了解小程序 */
.intro-card {
    display: flex;
    flex-direction: column;
    margin-top: 24rpx;
    padding: 28rpx 32rpx;
    border-radius: 24rpx;
    background: #ffffff;
    box-shadow: 0 4rpx 16rpx rgba(31, 35, 41, 0.04);
}

.intro-title {
    font-size: 30rpx;
    font-weight: 700;
    color: #1f2329;
}

.intro-line {
    margin-top: 16rpx;
    font-size: 26rpx;
    line-height: 1.6;
    color: #4a5468;
}

.intro-note {
    margin-top: 22rpx;
    font-size: 24rpx;
    line-height: 1.6;
    color: #8a94a6;
}
