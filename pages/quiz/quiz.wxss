.page {
    box-sizing: border-box;
    min-height: 100vh;
    padding: 24rpx 32rpx 48rpx;
}

.content {
    display: flex;
    flex-direction: column;
}

.hero {
    padding: 16rpx 8rpx 8rpx;
}

.hero-title {
    display: block;
    font-size: 40rpx;
    font-weight: 700;
    color: #1f2329;
}

.hero-sub {
    display: block;
    margin-top: 8rpx;
    font-size: 24rpx;
    color: #8a94a6;
}

.qp-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 24rpx;
    padding: 28rpx 32rpx;
    border-radius: 24rpx;
    background: linear-gradient(135deg, #3b6ef5, #5b8cff);
}

.qp-title {
    display: block;
    font-size: 30rpx;
    font-weight: 700;
    color: #ffffff;
}

.qp-desc {
    display: block;
    margin-top: 8rpx;
    font-size: 24rpx;
    color: rgba(255, 255, 255, 0.9);
}

.qp-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-left: 20rpx;
    height: 64rpx;
    padding: 0 32rpx;
    line-height: 1;
    font-size: 26rpx;
    font-weight: 600;
    color: #3b6ef5;
    background: #ffffff;
    border-radius: 32rpx;
}

.subject-card {
    margin-top: 24rpx;
    padding: 28rpx 32rpx;
    border-radius: 24rpx;
    background: #ffffff;
    box-shadow: 0 4rpx 16rpx rgba(31, 35, 41, 0.04);
}

.subject-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
}

.subject-title {
    font-size: 28rpx;
    font-weight: 600;
    color: #1f2329;
}

.subject-all {
    font-size: 24rpx;
    color: #3b6ef5;
}

.subject-list {
    margin-top: 12rpx;
}

.subject-row {
    display: flex;
    align-items: center;
    padding: 18rpx 0;
    border-bottom: 2rpx solid #f0f1f2;
}

.subject-row:last-child {
    border-bottom: none;
}

.check {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40rpx;
    height: 40rpx;
    border: 2rpx solid #d3d9e6;
    border-radius: 50%;
    background: #ffffff;
}

.check-on {
    border-color: #3b6ef5;
    background: #3b6ef5;
}

.check-mark {
    font-size: 24rpx;
    line-height: 1;
    color: #ffffff;
}

.subject-name {
    flex: 1;
    margin-left: 16rpx;
    font-size: 26rpx;
    color: #1f2329;
}

.subject-count {
    font-size: 22rpx;
    color: #8a94a6;
}

.subject-empty {
    display: block;
    padding: 20rpx 0;
    font-size: 24rpx;
    color: #b6bcc8;
}

.subject-tip {
    display: block;
    margin-top: 12rpx;
    font-size: 21rpx;
    color: #b6bcc8;
}

.order-card {
    margin-top: 24rpx;
    padding: 28rpx 32rpx;
    border-radius: 24rpx;
    background: #ffffff;
    box-shadow: 0 4rpx 16rpx rgba(31, 35, 41, 0.04);
}

.order-head {
    display: flex;
    flex-direction: column;
}

.order-title {
    font-size: 28rpx;
    font-weight: 600;
    color: #1f2329;
}

.order-desc {
    margin-top: 6rpx;
    font-size: 22rpx;
    color: #8a94a6;
}

.seg {
    display: flex;
    margin-top: 20rpx;
    padding: 6rpx;
    border-radius: 16rpx;
    background: #f4f6fb;
}

.seg-item {
    flex: 1;
    padding: 14rpx 0;
    font-size: 26rpx;
    text-align: center;
    color: #5b6472;
    border-radius: 12rpx;
}

.seg-active {
    font-weight: 600;
    color: #3b6ef5;
    background: #ffffff;
    box-shadow: 0 2rpx 8rpx rgba(59, 110, 245, 0.15);
}

.stat-card {
    display: flex;
    margin-top: 24rpx;
    padding: 28rpx 0;
    border-radius: 24rpx;
    background: #ffffff;
    box-shadow: 0 4rpx 16rpx rgba(31, 35, 41, 0.04);
}

.stat-cell {
    flex: 1;
    text-align: center;
}

.stat-num {
    display: block;
    font-size: 40rpx;
    font-weight: 700;
    color: #1f2329;
}

.stat-label {
    display: block;
    margin-top: 6rpx;
    font-size: 22rpx;
    color: #8a94a6;
}

.entry-list {
    margin-top: 24rpx;
    border-radius: 24rpx;
    background: #ffffff;
    box-shadow: 0 4rpx 16rpx rgba(31, 35, 41, 0.04);
}

.entry {
    display: flex;
    align-items: center;
    padding: 28rpx 32rpx;
    border-bottom: 2rpx solid #f0f1f2;
}

.entry:last-child {
    border-bottom: none;
}

.entry-emoji {
    font-size: 36rpx;
}

.entry-text {
    flex: 1;
    margin-left: 20rpx;
    font-size: 28rpx;
    color: #1f2329;
}

.entry-arrow {
    font-size: 36rpx;
    color: #c0c6cf;
}

.mask {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    align-items: flex-end;
    background: rgba(0, 0, 0, 0.45);
}

.sheet {
    box-sizing: border-box;
    width: 100%;
    padding: 40rpx 32rpx 48rpx;
    border-radius: 32rpx 32rpx 0 0;
    background: #ffffff;
}

.sheet-title {
    display: block;
    font-size: 32rpx;
    font-weight: 700;
    color: #1f2329;
}

.sheet-input {
    height: 88rpx;
    padding: 0 24rpx;
    margin-top: 24rpx;
    font-size: 28rpx;
    background: #f4f6fb;
    border-radius: 16rpx;
}

.guest-banner {
    display: flex;
    flex-direction: column;
    padding: 22rpx 26rpx;
    margin-bottom: 24rpx;
    background: #eef3ff;
    border-radius: 16rpx;
}

.guest-banner-title {
    font-size: 27rpx;
    font-weight: 600;
    color: #3b6ef5;
}

.guest-banner-desc {
    margin-top: 8rpx;
    font-size: 24rpx;
    line-height: 1.6;
    color: #5a6478;
}

.sheet-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    margin-top: 32rpx;
    height: 88rpx;
    line-height: 1;
    font-size: 30rpx;
    font-weight: 600;
    color: #ffffff;
    background: #3b6ef5;
    border-radius: 44rpx;
}
