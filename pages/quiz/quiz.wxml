<view class="page">
    <guest-gate id="guestGate" wx:if="{{authState === 'signed-out'}}" bind:signedin="onSignedIn" />
    <view wx:if="{{authState === 'checking'}}" class="state-box">
        <view class="spinner"></view>
        <text class="state-text">加载中...</text>
    </view>

    <view wx:else class="content">
        <view class="hero">
            <text class="hero-title">当前刷题计划</text>
            <text class="hero-sub">按每日题量练习总计划里的题目</text>
        </view>

        <view class="qp-card">
            <view class="qp-info">
                <text class="qp-title">今日刷题</text>
                <text class="qp-desc">已完成 {{todayDone}} / {{dailyQuestions}} 题</text>
            </view>
            <button class="qp-btn" bindtap="goStart">开始刷题</button>
        </view>

        <view class="subject-card">
            <view class="subject-head">
                <text class="subject-title">刷题科目</text>
                <text class="subject-all" catchtap="selectAllBanks">全选</text>
            </view>
            <view class="subject-list">
                <view class="subject-row" wx:for="{{banks}}" wx:key="id" data-id="{{item.id}}" bindtap="toggleBank">
                    <view class="check {{item.selected ? 'check-on' : ''}}">
                        <text wx:if="{{item.selected}}" class="check-mark">✓</text>
                    </view>
                    <text class="subject-name">{{item.name}}</text>
                    <text class="subject-count">{{item.count}} 题</text>
                </view>
                <text wx:if="{{banks.length === 0}}" class="subject-empty">暂无题库，先到「添加题库」新建或订阅</text>
            </view>
            <text class="subject-tip">只刷勾选的科目，今日刷题会从这些科目里出题</text>
        </view>

        <view class="order-card">
            <view class="order-head">
                <text class="order-title">刷题顺序</text>
                <text class="order-desc">{{orderMode === 'random' ? '每次刷题随机打乱，避免背答案位置' : '按题库原有顺序依次练习'}}</text>
            </view>
            <view class="seg">
                <view class="seg-item {{orderMode === 'random' ? 'seg-active' : ''}}" data-mode="random" bindtap="onOrderTap">🔀 乱序</view>
                <view class="seg-item {{orderMode === 'order' ? 'seg-active' : ''}}" data-mode="order" bindtap="onOrderTap">🔢 顺序</view>
            </view>
        </view>

        <view class="stat-card">
            <view class="stat-cell">
                <text class="stat-num">{{planTotal}}</text>
                <text class="stat-label">总计划</text>
            </view>
            <view class="stat-cell">
                <text class="stat-num">{{planDone}}</text>
                <text class="stat-label">已做</text>
            </view>
        </view>

        <view class="entry-list">
            <view class="entry" bindtap="goPresetBank">
                <text class="entry-emoji">🗂️</text>
                <text class="entry-text">题库 / 词库总览（{{banks.length}} 个，可管理、取消订阅）</text>
                <text class="entry-arrow">›</text>
            </view>
            <view class="entry" bindtap="goPlan">
                <text class="entry-emoji">🗓️</text>
                <text class="entry-text">刷题计划设置</text>
                <text class="entry-arrow">›</text>
            </view>
            <view class="entry" bindtap="goRecords">
                <text class="entry-emoji">🌟</text>
                <text class="entry-text">学习记录（可删除重做）</text>
                <text class="entry-arrow">›</text>
            </view>
            <view class="entry" bindtap="openCreate">
                <text class="entry-emoji">➕</text>
                <text class="entry-text">新建题库</text>
                <text class="entry-arrow">›</text>
            </view>
            <view class="entry" bindtap="goImport">
                <text class="entry-emoji">📥</text>
                <text class="entry-text">导入题目</text>
                <text class="entry-arrow">›</text>
            </view>
        </view>
    </view>

    <view wx:if="{{showCreate}}" class="mask" bindtap="closeCreate">
        <view class="sheet" catchtap="noop">
            <text class="sheet-title">新建题库</text>
            <input class="sheet-input" placeholder="名称（必填）" value="{{formName}}" bindinput="onNameInput" />
            <input class="sheet-input" placeholder="简介（可选）" value="{{formDesc}}" bindinput="onDescInput" />
            <button class="sheet-btn" loading="{{saving}}" disabled="{{saving}}" bindtap="submitCreate">保存</button>
        </view>
    </view>
</view>
