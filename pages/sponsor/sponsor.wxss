.page {
    box-sizing: border-box;
    min-height: 100vh;
    padding: 24rpx 32rpx 48rpx;
}

.hero {
    padding: 16rpx 8rpx 8rpx;
}

.hero-title {
    display: block;
    font-size: 44rpx;
    font-weight: 700;
    color: #1f2329;
}

.hero-sub {
    display: block;
    margin-top: 10rpx;
    font-size: 26rpx;
    color: #8a94a6;
}

.qr-block {
    margin-top: 28rpx;
    padding: 28rpx;
    border-radius: 24rpx;
    background: #ffffff;
    box-shadow: 0 4rpx 16rpx rgba(31, 35, 41, 0.04);
    text-align: center;
}

.qr-label {
    display: inline-block;
    padding: 8rpx 28rpx;
    border-radius: 24rpx;
    font-size: 26rpx;
    font-weight: 600;
    color: #ffffff;
}

.qr-label.wechat {
    background: #17a673;
}

.qr-label.alipay {
    background: #1677ff;
}

.qr-img {
    display: block;
    width: 440rpx;
    margin: 24rpx auto 0;
    border-radius: 16rpx;
}

.tip {
    display: block;
    margin-top: 28rpx;
    text-align: center;
    font-size: 24rpx;
    color: #8a94a6;
}

.thanks {
    display: block;
    margin-top: 12rpx;
    text-align: center;
    font-size: 24rpx;
    color: #b6bcc8;
}
