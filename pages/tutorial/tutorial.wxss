.page {
    box-sizing: border-box;
    min-height: 100vh;
    padding: 24rpx 32rpx 48rpx;
}

.hero {
    padding: 16rpx 8rpx 24rpx;
}

.hero-title {
    display: block;
    font-size: 44rpx;
    font-weight: 700;
    color: #1f2329;
}

.hero-sub {
    display: block;
    margin-top: 10rpx;
    font-size: 26rpx;
    color: #8a94a6;
}

.step {
    display: flex;
    padding: 28rpx;
    margin-bottom: 20rpx;
    border-radius: 24rpx;
    background: #ffffff;
    box-shadow: 0 4rpx 16rpx rgba(31, 35, 41, 0.04);
}

.step-index {
    display: flex;
    width: 56rpx;
    height: 56rpx;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    border-radius: 50%;
    background: #3b6ef5;
    color: #ffffff;
    font-size: 28rpx;
    font-weight: 700;
}

.step-body {
    flex: 1;
    margin-left: 24rpx;
}

.step-title {
    display: block;
    font-size: 30rpx;
    font-weight: 600;
    color: #1f2329;
}

.step-desc {
    display: block;
    margin-top: 10rpx;
    font-size: 25rpx;
    line-height: 1.7;
    color: #8a94a6;
}

.tip-card {
    margin-top: 8rpx;
    padding: 28rpx;
    border-radius: 24rpx;
    background: #f2f7ff;
}

.tip-title {
    display: block;
    font-size: 28rpx;
    font-weight: 600;
    color: #3b6ef5;
}

.tip-text {
    display: block;
    margin-top: 10rpx;
    font-size: 24rpx;
    line-height: 1.7;
    color: #5b6b82;
}
