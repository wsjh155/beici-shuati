.page {
    box-sizing: border-box;
    min-height: 100vh;
    padding: 24rpx 32rpx 48rpx;
}

.content {
    display: flex;
    flex-direction: column;
}

.header {
    padding: 16rpx 8rpx 20rpx;
}

.title {
    display: block;
    font-size: 40rpx;
    font-weight: 700;
    color: #1f2329;
}

.subtitle {
    display: block;
    margin-top: 8rpx;
    font-size: 25rpx;
    line-height: 1.6;
    color: #8a94a6;
}

.entry-row {
    display: flex;
    margin: 8rpx 0 24rpx;
}

.entry-btn {
    flex: 1;
    height: 76rpx;
    margin-right: 16rpx;
    font-size: 26rpx;
    font-weight: 600;
    color: #3b6ef5;
    background: #eef3ff;
    border-radius: 18rpx;
}

.entry-btn:last-child {
    margin-right: 0;
}

.entry-btn.primary {
    color: #ffffff;
    background: #3b6ef5;
}

.tab-bar {
    display: flex;
    padding: 6rpx;
    margin-bottom: 20rpx;
    background: #eef1f6;
    border-radius: 18rpx;
}

.tab-item {
    flex: 1;
    padding: 16rpx 0;
    text-align: center;
    font-size: 25rpx;
    color: #8a94a6;
    border-radius: 14rpx;
}

.tab-item.active {
    font-weight: 700;
    color: #3b6ef5;
    background: #ffffff;
}

.card {
    display: flex;
    align-items: center;
    padding: 24rpx;
    margin-bottom: 16rpx;
    background: #ffffff;
    border-radius: 20rpx;
    box-shadow: 0 4rpx 12rpx rgba(31, 35, 41, 0.04);
}

.card-info {
    flex: 1;
    overflow: hidden;
}

.card-name {
    display: block;
    font-size: 30rpx;
    font-weight: 600;
    color: #1f2329;
}

.card-desc {
    display: block;
    margin-top: 6rpx;
    font-size: 24rpx;
    color: #8a94a6;
}

.card-count {
    display: block;
    margin-top: 6rpx;
    font-size: 22rpx;
    color: #b6bcc8;
}

.card-actions {
    display: flex;
    flex-direction: column;
    flex-shrink: 0;
    margin-left: 16rpx;
}

.btn-on {
    flex-shrink: 0;
    width: 132rpx;
    height: 64rpx;
    font-size: 25rpx;
    font-weight: 600;
    color: #ffffff;
    background: #3b6ef5;
    border-radius: 32rpx;
}

.btn-off {
    flex-shrink: 0;
    width: 132rpx;
    height: 64rpx;
    font-size: 25rpx;
    color: #8a94a6;
    background: #f0f1f2;
    border-radius: 32rpx;
}

.btn-del {
    width: 132rpx;
    height: 56rpx;
    margin-bottom: 10rpx;
    font-size: 23rpx;
    color: #e05a5a;
    background: #fff1f1;
    border-radius: 28rpx;
}

.empty {
    display: flex;
    align-items: center;
    flex-direction: column;
    padding: 96rpx 0;
}

.empty-emoji {
    font-size: 72rpx;
}

.empty-text {
    margin-top: 24rpx;
    font-size: 30rpx;
    color: #1f2329;
}

.empty-sub {
    margin-top: 12rpx;
    font-size: 24rpx;
    color: #b6bcc8;
}

.state-box {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 160rpx 0;
}

.state-text {
    margin-left: 16rpx;
    font-size: 26rpx;
    color: #8a94a6;
}

.spinner {
    width: 36rpx;
    height: 36rpx;
    border: 4rpx solid #dbe4ff;
    border-top-color: #3b6ef5;
    border-radius: 50%;
}
