.page {
    min-height: 100vh;
    padding: 24rpx 28rpx 60rpx;
    box-sizing: border-box;
    background: #f5f7fa;
}

.tabs {
    display: flex;
    background: #fff;
    border-radius: 18rpx;
    padding: 8rpx;
    margin-bottom: 24rpx;
}

.tab {
    flex: 1;
    text-align: center;
    padding: 20rpx 0;
    font-size: 28rpx;
    color: #8a94a6;
    border-radius: 14rpx;
}

.tab.active {
    color: #fff;
    background: #3b6ef5;
    font-weight: 600;
}

.doc {
    background: #fff;
    border-radius: 18rpx;
    padding: 32rpx 30rpx;
    display: flex;
    flex-direction: column;
}

.h1 {
    font-size: 36rpx;
    font-weight: 700;
    color: #1f2733;
}

.meta {
    display: block;
    margin: 10rpx 0 24rpx;
    font-size: 24rpx;
    color: #9aa4b5;
}

.h2 {
    display: block;
    margin: 30rpx 0 12rpx;
    font-size: 29rpx;
    font-weight: 600;
    color: #2f3a4d;
}

.p {
    display: block;
    margin-bottom: 14rpx;
    font-size: 26rpx;
    line-height: 1.75;
    color: #5a6478;
}

.back-btn {
    margin-top: 32rpx;
    height: 84rpx;
    font-size: 28rpx;
    color: #3b6ef5;
    background: #fff;
    border-radius: 16rpx;
}
