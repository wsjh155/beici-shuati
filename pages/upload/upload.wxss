.page {
    box-sizing: border-box;
    min-height: 100vh;
    padding: 24rpx 32rpx 64rpx;
}

.content {
    display: flex;
    flex-direction: column;
}

.header {
    padding: 16rpx 8rpx 24rpx;
}

.title {
    display: block;
    font-size: 40rpx;
    font-weight: 700;
    color: #1f2329;
}

.subtitle {
    display: block;
    margin-top: 8rpx;
    font-size: 25rpx;
    line-height: 1.6;
    color: #8a94a6;
}

.seg {
    display: flex;
    padding: 6rpx;
    margin-bottom: 24rpx;
    background: #eef1f6;
    border-radius: 18rpx;
}

.seg.qtype {
    margin: 24rpx 0 8rpx;
}

.seg-item {
    flex: 1;
    padding: 16rpx 0;
    text-align: center;
    font-size: 26rpx;
    color: #8a94a6;
    border-radius: 14rpx;
}

.seg-item.active {
    font-weight: 700;
    color: #3b6ef5;
    background: #ffffff;
}

.form {
    padding: 24rpx;
    background: #ffffff;
    border-radius: 20rpx;
}

.label {
    display: block;
    margin: 12rpx 0 12rpx;
    font-size: 26rpx;
    font-weight: 600;
    color: #4a5262;
}

.input {
    height: 76rpx;
    padding: 0 20rpx;
    font-size: 26rpx;
    color: #1f2329;
    background: #f7f9fd;
    border-radius: 14rpx;
}

.textarea {
    width: 100%;
    height: 320rpx;
    box-sizing: border-box;
    padding: 20rpx;
    font-size: 25rpx;
    line-height: 1.7;
    color: #1f2329;
    background: #f7f9fd;
    border-radius: 14rpx;
}

.tip {
    display: block;
    margin-top: 12rpx;
    font-size: 23rpx;
    line-height: 1.6;
    color: #8a94a6;
}

.count {
    display: block;
    margin-top: 8rpx;
    font-size: 24rpx;
    color: #3b6ef5;
}

.submit {
    height: 88rpx;
    margin-top: 32rpx;
    font-size: 30rpx;
    font-weight: 600;
    color: #ffffff;
    background: #3b6ef5;
    border-radius: 20rpx;
}

.note {
    display: block;
    margin-top: 16rpx;
    text-align: center;
    font-size: 23rpx;
    color: #b6bcc8;
}

.state-box {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 160rpx 0;
}

.state-text {
    margin-left: 16rpx;
    font-size: 26rpx;
    color: #8a94a6;
}

.spinner {
    width: 36rpx;
    height: 36rpx;
    border: 4rpx solid #dbe4ff;
    border-top-color: #3b6ef5;
    border-radius: 50%;
}
