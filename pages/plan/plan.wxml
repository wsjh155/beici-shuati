<view class="page">
    <guest-gate id="guestGate" wx:if="{{authState === 'signed-out'}}" bind:signedin="onSignedIn" />
    <view wx:if="{{authState === 'checking'}}" class="state-box">
        <view class="spinner"></view>
        <text class="state-text">加载中...</text>
    </view>

    <view wx:else class="content">
        <view class="overview">
            <view class="ov-card ov-blue">
                <text class="ov-num">{{dueCount}}</text>
                <text class="ov-label">今日待复习</text>
            </view>
            <view class="ov-card ov-green">
                <text class="ov-num">{{newCount}}</text>
                <text class="ov-label">待学习新词</text>
            </view>
            <view class="ov-card">
                <text class="ov-num">{{masteredCount}}/{{totalWords}}</text>
                <text class="ov-label">已掌握</text>
            </view>
        </view>

        <view class="card">
            <text class="card-title">背词计划</text>
            <view class="setting-row">
                <text class="setting-label">每日新词</text>
                <text class="setting-value">{{dailyNew}} 个</text>
            </view>
            <slider min="5" max="50" step="5" value="{{dailyNew}}" activeColor="#3b6ef5" block-size="24" bindchange="onNewChange" />

            <view class="setting-row">
                <text class="setting-label">每日复习</text>
                <text class="setting-value">{{dailyReview}} 个</text>
            </view>
            <slider min="10" max="100" step="10" value="{{dailyReview}}" activeColor="#3b6ef5" block-size="24" bindchange="onReviewChange" />

            <view class="setting-row">
                <text class="setting-label">学习顺序</text>
                <text class="setting-value">{{wordOrder === 'random' ? '乱序' : '顺序'}}</text>
            </view>
            <view class="seg">
                <view class="seg-item {{wordOrder === 'random' ? 'seg-active' : ''}}" data-kind="word" data-mode="random" bindtap="onOrderTap">🔀 乱序</view>
                <view class="seg-item {{wordOrder === 'order' ? 'seg-active' : ''}}" data-kind="word" data-mode="order" bindtap="onOrderTap">🔢 顺序</view>
            </view>

            <view class="setting-row">
                <view class="setting-text">
                    <text class="setting-label">根据掌握情况自动调整</text>
                    <text class="setting-desc">学习时自动按正确率增减新词量</text>
                </view>
                <switch checked="{{autoAdjust}}" color="#3b6ef5" bindchange="onAutoToggle" />
            </view>
        </view>

        <view class="card">
            <text class="card-title">刷题计划</text>
            <view class="setting-row">
                <text class="setting-label">每日刷题</text>
                <text class="setting-value">{{dailyQuestions}} 题</text>
            </view>
            <slider min="5" max="100" step="5" value="{{dailyQuestions}}" activeColor="#3b6ef5" block-size="24" bindchange="onQuestionsChange" />

            <view class="setting-row">
                <text class="setting-label">刷题顺序</text>
                <text class="setting-value">{{questionOrder === 'random' ? '乱序' : '顺序'}}</text>
            </view>
            <view class="seg">
                <view class="seg-item {{questionOrder === 'random' ? 'seg-active' : ''}}" data-kind="question" data-mode="random" bindtap="onOrderTap">🔀 乱序</view>
                <view class="seg-item {{questionOrder === 'order' ? 'seg-active' : ''}}" data-kind="question" data-mode="order" bindtap="onOrderTap">🔢 顺序</view>
            </view>
        </view>

        <view class="card">
            <view class="panel-head" bindtap="toggleLibPanel">
                <view class="panel-text">
                    <text class="card-title">词库顺序</text>
                    <text class="panel-desc">每个词库单独选乱序 / 顺序，点词库名按该顺序开始背诵</text>
                </view>
                <text class="chevron">{{showLibOrder ? '收起' : '展开'}}</text>
            </view>
            <view wx:if="{{showLibOrder}}" class="panel-body">
                <view class="lib-group" wx:for="{{libGroups}}" wx:key="id" wx:for-item="g">
                    <text class="lib-group-title">{{g.name}}</text>
                    <view class="order-row" wx:for="{{g.libraries}}" wx:key="id" wx:for-item="lib">
                        <view class="order-name" data-id="{{lib.id}}" data-order="{{lib.order}}" bindtap="goLibStudy">
                            <text class="order-main">{{lib.name}}</text>
                            <text class="order-sub">{{lib.wordCount}} 词</text>
                        </view>
                        <view class="seg seg-mini">
                            <view class="seg-item {{lib.order === 'random' ? 'seg-active' : ''}}" data-id="{{lib.id}}" data-order="random" catchtap="onLibOrderTap">乱序</view>
                            <view class="seg-item {{lib.order === 'order' ? 'seg-active' : ''}}" data-id="{{lib.id}}" data-order="order" catchtap="onLibOrderTap">顺序</view>
                        </view>
                    </view>
                </view>
                <text wx:if="{{libGroups.length === 0}}" class="panel-empty">暂无词库</text>
            </view>
        </view>

        <view class="card">
            <view class="panel-head" bindtap="toggleBankPanel">
                <view class="panel-text">
                    <text class="card-title">题库顺序</text>
                    <text class="panel-desc">每个题库单独选乱序 / 顺序，点题库名按该顺序开始刷题</text>
                </view>
                <text class="chevron">{{showBankOrder ? '收起' : '展开'}}</text>
            </view>
            <view wx:if="{{showBankOrder}}" class="panel-body">
                <view class="order-row" wx:for="{{banks}}" wx:key="id" wx:for-item="b">
                    <view class="order-name" data-id="{{b.id}}" data-order="{{b.order}}" bindtap="goBankPractice">
                        <text class="order-main">{{b.name}}</text>
                    </view>
                    <view class="seg seg-mini">
                        <view class="seg-item {{b.order === 'random' ? 'seg-active' : ''}}" data-id="{{b.id}}" data-order="random" catchtap="onBankOrderTap">乱序</view>
                        <view class="seg-item {{b.order === 'order' ? 'seg-active' : ''}}" data-id="{{b.id}}" data-order="order" catchtap="onBankOrderTap">顺序</view>
                    </view>
                </view>
                <text wx:if="{{banks.length === 0}}" class="panel-empty">暂无题库</text>
            </view>
        </view>

        <view class="card">
            <text class="card-title">智能建议</text>
            <text class="adjust-tip">{{adjustTip}}</text>
            <text class="adjust-sub">近 7 天复习正确率：{{recentAccuracy}}%</text>
            <text class="adjust-note">复习采用艾宾浩斯遗忘曲线间隔（1/2/4/7/15/30 天），到期自动提醒</text>
        </view>

        <button class="start-btn" bindtap="goStartPlan">▶ 开始今日计划</button>

        <button class="save-btn" loading="{{saving}}" disabled="{{saving}}" bindtap="save">保存计划</button>
    </view>
</view>
