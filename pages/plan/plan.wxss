.page {
    box-sizing: border-box;
    min-height: 100vh;
    padding: 24rpx 32rpx 48rpx;
}

.content {
    display: flex;
    flex-direction: column;
}

.overview {
    display: flex;
}

.ov-card {
    flex: 1;
    box-sizing: border-box;
    padding: 28rpx 20rpx;
    border-radius: 20rpx;
    background: #ffffff;
    text-align: center;
    box-shadow: 0 4rpx 16rpx rgba(31, 35, 41, 0.04);
}

.ov-card + .ov-card {
    margin-left: 16rpx;
}

.ov-blue {
    background: linear-gradient(135deg, #3b6ef5, #5b8cff);
}

.ov-green {
    background: linear-gradient(135deg, #17a673, #3ecb96);
}

.ov-blue .ov-num,
.ov-green .ov-num {
    color: #ffffff;
}

.ov-blue .ov-label,
.ov-green .ov-label {
    color: rgba(255, 255, 255, 0.9);
}

.ov-num {
    display: block;
    font-size: 44rpx;
    font-weight: 700;
    color: #1f2329;
}

.ov-label {
    display: block;
    margin-top: 8rpx;
    font-size: 22rpx;
    color: #8a94a6;
}

.card {
    margin-top: 24rpx;
    padding: 32rpx;
    border-radius: 24rpx;
    background: #ffffff;
    box-shadow: 0 4rpx 16rpx rgba(31, 35, 41, 0.04);
}

.card-title {
    display: block;
    font-size: 30rpx;
    font-weight: 700;
    color: #1f2329;
}

.setting-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 28rpx;
}

.setting-text {
    display: flex;
    flex-direction: column;
}

.setting-label {
    font-size: 28rpx;
    color: #1f2329;
}

.setting-desc {
    margin-top: 4rpx;
    font-size: 22rpx;
    color: #8a94a6;
}

.setting-value {
    font-size: 28rpx;
    font-weight: 600;
    color: #3b6ef5;
}

/* 词库 / 题库顺序面板 */
.panel-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.panel-text {
    display: flex;
    flex: 1;
    flex-direction: column;
}

.panel-desc {
    margin-top: 6rpx;
    font-size: 22rpx;
    color: #8a94a6;
}

.chevron {
    flex-shrink: 0;
    margin-left: 16rpx;
    font-size: 24rpx;
    color: #3b6ef5;
}

.panel-body {
    margin-top: 20rpx;
}

.panel-empty {
    display: block;
    padding: 24rpx 0;
    font-size: 24rpx;
    text-align: center;
    color: #b6bcc8;
}

.lib-group + .lib-group {
    margin-top: 16rpx;
}

.lib-group-title {
    display: block;
    margin: 8rpx 0 10rpx;
    font-size: 24rpx;
    font-weight: 600;
    color: #3b6ef5;
}

.order-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18rpx 0;
    border-bottom: 2rpx solid #f0f1f2;
}

.order-row:last-child {
    border-bottom: none;
}

.order-name {
    flex: 1;
    overflow: hidden;
}

.order-main {
    display: block;
    font-size: 26rpx;
    color: #1f2329;
}

.order-sub {
    display: block;
    margin-top: 4rpx;
    font-size: 22rpx;
    color: #b6bcc8;
}

.seg-mini {
    flex: none;
    width: 220rpx;
    margin-top: 0;
    margin-left: 16rpx;
}

.seg-mini .seg-item {
    padding: 10rpx 0;
    font-size: 22rpx;
}

.seg {
    display: flex;
    margin-top: 4rpx;
    padding: 6rpx;
    border-radius: 16rpx;
    background: #f4f6fb;
}

.seg-item {
    flex: 1;
    padding: 14rpx 0;
    font-size: 26rpx;
    text-align: center;
    color: #5b6472;
    border-radius: 12rpx;
}

.seg-active {
    font-weight: 600;
    color: #3b6ef5;
    background: #ffffff;
    box-shadow: 0 2rpx 8rpx rgba(59, 110, 245, 0.15);
}

.adjust-tip {
    display: block;
    margin-top: 20rpx;
    font-size: 28rpx;
    color: #1f2329;
}

.adjust-sub {
    display: block;
    margin-top: 12rpx;
    font-size: 24rpx;
    color: #8a94a6;
}

.adjust-note {
    display: block;
    margin-top: 16rpx;
    font-size: 22rpx;
    line-height: 1.6;
    color: #b6bcc8;
}

.start-btn {
    margin-top: 40rpx;
    height: 96rpx;
    line-height: 96rpx;
    font-size: 32rpx;
    font-weight: 600;
    color: #ffffff;
    background: #17a673;
    border-radius: 48rpx;
}

.save-btn {
    margin-top: 20rpx;
    height: 88rpx;
    line-height: 88rpx;
    font-size: 30rpx;
    font-weight: 600;
    color: #ffffff;
    background: #3b6ef5;
    border-radius: 44rpx;
}
