.page {
    box-sizing: border-box;
    min-height: 100vh;
    padding: 24rpx 32rpx 48rpx;
}

.empty-emoji {
    font-size: 80rpx;
}

.empty-text {
    margin-top: 24rpx;
    font-size: 32rpx;
    color: #1f2329;
}

.empty-sub {
    margin-top: 12rpx;
    font-size: 26rpx;
    color: #8a94a6;
}

.back-btn {
    margin-top: 48rpx;
    width: 320rpx;
    height: 84rpx;
    line-height: 84rpx;
    font-size: 28rpx;
    color: #ffffff;
    background: #3b6ef5;
    border-radius: 42rpx;
}

.study {
    display: flex;
    flex-direction: column;
}

.progress-bar {
    width: 100%;
    height: 12rpx;
    border-radius: 6rpx;
    background: #e6ebf5;
    overflow: hidden;
}

.progress-fill {
    height: 100%;
    border-radius: 6rpx;
    background: #3b6ef5;
    transition: width 0.3s ease;
}

.progress-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 16rpx;
}

.progress-text {
    font-size: 24rpx;
    color: #8a94a6;
}

.order-pill {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 20rpx;
    height: 48rpx;
    border-radius: 24rpx;
    background: #eef2fb;
}

.order-pill-text {
    font-size: 22rpx;
    font-weight: 600;
    color: #3b6ef5;
    line-height: 1;
}

.card-scene {
    margin-top: 32rpx;
    perspective: 1200rpx;
}

.card {
    position: relative;
    width: 100%;
    height: 520rpx;
    transform-style: preserve-3d;
    transition: transform 0.5s;
}

.card.flipped {
    transform: rotateY(180deg);
}

.card-face {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    flex-direction: column;
    justify-content: center;
    padding: 48rpx;
    border-radius: 32rpx;
    background: #ffffff;
    box-shadow: 0 12rpx 40rpx rgba(31, 35, 41, 0.08);
    backface-visibility: hidden;
}

.card-back {
    transform: rotateY(180deg);
    background: linear-gradient(160deg, #3b6ef5, #5b8cff);
    color: #ffffff;
}

.word {
    font-size: 72rpx;
    font-weight: 700;
    color: #1f2329;
}

.word-small {
    font-size: 44rpx;
    font-weight: 700;
    color: #ffffff;
}

.phonetic {
    margin-top: 20rpx;
    font-size: 30rpx;
    color: #8a94a6;
}

.hint {
    margin-top: 48rpx;
    font-size: 24rpx;
    color: #b6bcc8;
}

.meaning {
    margin-top: 24rpx;
    font-size: 36rpx;
    line-height: 1.5;
    text-align: center;
    color: #ffffff;
}

.example {
    margin-top: 24rpx;
    font-size: 26rpx;
    line-height: 1.6;
    text-align: center;
    color: rgba(255, 255, 255, 0.9);
}

.audio-btn {
    align-self: center;
    margin-top: 40rpx;
    padding: 20rpx 48rpx;
    font-size: 28rpx;
    color: #3b6ef5;
    background: #e8efff;
    border-radius: 40rpx;
}

.actions {
    display: flex;
    margin-top: 64rpx;
}

.action-btn {
    flex: 1;
    height: 96rpx;
    line-height: 96rpx;
    font-size: 32rpx;
    font-weight: 600;
    border-radius: 48rpx;
}

.action-btn::after {
    border: none;
}

.action-forgot {
    margin-right: 24rpx;
    color: #e5484d;
    background: #fdecec;
}

.action-known {
    color: #ffffff;
    background: #17a673;
}

.guest-tip {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18rpx 22rpx;
    margin-bottom: 20rpx;
    background: #eef3ff;
    border-radius: 14rpx;
}

.guest-tip-text {
    font-size: 23rpx;
    color: #5a6478;
}

.guest-tip-link {
    font-size: 24rpx;
    color: #3b6ef5;
    font-weight: 600;
}

.login-cta {
    width: 100%;
    height: 84rpx;
    margin-bottom: 20rpx;
    font-size: 28rpx;
    color: #ffffff;
    background: #3b6ef5;
    border-radius: 16rpx;
}
