<view class="page">
    <view wx:if="{{authState === 'checking'}}" class="state-box">
        <view class="spinner"></view>
        <text class="state-text">加载中...</text>
    </view>

    <view wx:elif="{{authState === 'signed-out'}}">
        <login-panel bind:signedin="onSignedIn" />
    </view>

    <view wx:else class="content">
        <view class="profile-card">
            <view class="avatar">{{avatarText}}</view>
            <view class="profile-info">
                <text class="profile-name">{{userName}}</text>
                <text class="profile-sub">数据已同步到云端</text>
            </view>
        </view>

        <view class="menu-list">
            <view class="menu-item" wx:for="{{menus}}" wx:key="key" data-path="{{item.path}}" bindtap="onMenuTap">
                <text class="menu-emoji">{{item.emoji}}</text>
                <view class="menu-info">
                    <text class="menu-text">{{item.text}}</text>
                    <text class="menu-desc">{{item.desc}}</text>
                </view>
                <text class="menu-arrow">›</text>
            </view>
        </view>

        <button class="logout-btn" bindtap="onLogout">退出登录</button>
    </view>
</view>
