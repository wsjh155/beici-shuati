.page {
    box-sizing: border-box;
    min-height: 100vh;
    padding: 24rpx 32rpx 48rpx;
}

.content {
    display: flex;
    flex-direction: column;
}

.hero {
    padding: 16rpx 8rpx 8rpx;
}

.hero-title {
    display: block;
    font-size: 40rpx;
    font-weight: 700;
    color: #1f2329;
}

.hero-sub {
    display: block;
    margin-top: 8rpx;
    font-size: 24rpx;
    color: #8a94a6;
}

.plan-card {
    margin-top: 24rpx;
    padding: 32rpx;
    border-radius: 24rpx;
    background: linear-gradient(135deg, #3b6ef5, #5b8cff);
}

.plan-row {
    display: flex;
}

.plan-item {
    flex: 1;
    text-align: center;
}

.plan-num {
    display: block;
    font-size: 52rpx;
    font-weight: 700;
    color: #ffffff;
}

.plan-label {
    display: block;
    margin-top: 6rpx;
    font-size: 24rpx;
    color: rgba(255, 255, 255, 0.9);
}

.start-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    margin-top: 28rpx;
    height: 80rpx;
    line-height: 1;
    font-size: 30rpx;
    font-weight: 600;
    color: #3b6ef5;
    background: #ffffff;
    border-radius: 40rpx;
}

.stat-card {
    display: flex;
    margin-top: 24rpx;
    padding: 28rpx 0;
    border-radius: 24rpx;
    background: #ffffff;
    box-shadow: 0 4rpx 16rpx rgba(31, 35, 41, 0.04);
}

.stat-cell {
    flex: 1;
    text-align: center;
}

.stat-num {
    display: block;
    font-size: 40rpx;
    font-weight: 700;
    color: #1f2329;
}

.stat-label {
    display: block;
    margin-top: 6rpx;
    font-size: 22rpx;
    color: #8a94a6;
}

.entry-list {
    margin-top: 24rpx;
    border-radius: 24rpx;
    background: #ffffff;
    box-shadow: 0 4rpx 16rpx rgba(31, 35, 41, 0.04);
}

.entry {
    display: flex;
    align-items: center;
    padding: 28rpx 32rpx;
    border-bottom: 2rpx solid #f0f1f2;
}

.entry:last-child {
    border-bottom: none;
}

.entry-emoji {
    font-size: 36rpx;
}

.entry-text {
    flex: 1;
    margin-left: 20rpx;
    font-size: 28rpx;
    color: #1f2329;
}

.entry-arrow {
    font-size: 36rpx;
    color: #c0c6cf;
}

.mask {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    align-items: flex-end;
    background: rgba(0, 0, 0, 0.45);
}

.sheet {
    box-sizing: border-box;
    width: 100%;
    padding: 40rpx 32rpx 48rpx;
    border-radius: 32rpx 32rpx 0 0;
    background: #ffffff;
}

.sheet-title {
    display: block;
    font-size: 32rpx;
    font-weight: 700;
    color: #1f2329;
}

.sheet-input {
    height: 88rpx;
    padding: 0 24rpx;
    margin-top: 24rpx;
    font-size: 28rpx;
    background: #f4f6fb;
    border-radius: 16rpx;
}

.sheet-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    margin-top: 32rpx;
    height: 88rpx;
    line-height: 1;
    font-size: 30rpx;
    font-weight: 600;
    color: #ffffff;
    background: #3b6ef5;
    border-radius: 44rpx;
}
